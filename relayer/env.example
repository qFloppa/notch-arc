# Gemini relayer for Notch dispute arbitration
# Copy this to .env and fill in your values

# Your Gemini API key (from Google AI Studio — https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Private key of the wallet set as `arbitrator` on the Notch contract.
# Must match the address you set via setArbitrator(), or the constructor arg if unchanged.
# WARNING: never commit this value.
ARBITRATOR_PRIVATE_KEY=0x...your_arbitrator_wallet_private_key

# Notch contract address on Arc Testnet
NOTCH_CONTRACT_ADDRESS=0x7c7cc8322ba3db93381823a9161e47a85d490fc8

# Arc Testnet RPC URL
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# How often to poll for new DisputeOpened events (milliseconds)
POLL_INTERVAL_MS=15000

# Port for the HTTP status server
PORT=3001

# Judge model (optional). Free-tier quota is per-model — switch if the daily cap is hit.
GEMINI_MODEL=gemini-3.8-flash
