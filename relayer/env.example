# Gemini relayer for Notch dispute arbitration
# Copy this to .env and fill in your values (local dev).
# On Vercel, set the same keys as Project → Settings → Environment Variables.

# Your Gemini API key (from Google AI Studio — https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Private key of the wallet set as `arbitrator` on the Notch contract.
# Must match the address you set via setArbitrator(), or the constructor arg if unchanged.
# WARNING: never commit this value, and never give it a VITE_ prefix — VITE_ vars are
# compiled into the browser bundle.
ARBITRATOR_PRIVATE_KEY=0x...your_arbitrator_wallet_private_key

# Notch contract address on Arc Testnet
NOTCH_CONTRACT_ADDRESS=0xeffe19557a9cac8bf25ef6d3f072481d46a0938a

# Arc Testnet RPC URL. Set this explicitly in production — the Arc Studio proxy token
# is a ~30min JWT and viem's default host rejects some server-side callers.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# Port for the local HTTP server (ignored on Vercel)
PORT=3001
